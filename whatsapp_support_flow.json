{
  "version": "6.3",
  "routing_model": {
    "DISPUTE_FORM": []
  },
  "screens": [
    {
      "id": "DISPUTE_FORM",
      "title": "WAJ VTU Dispute Form",
      "terminal": true,
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "TextHeading",
            "text": "Official Dispute & Support Form"
          },
          {
            "type": "TextSubheading",
            "text": "Submitted details are delivered directly to our 24/7 supervisor desk."
          },
          {
            "type": "Dropdown",
            "name": "service_type",
            "label": "Service Category",
            "required": true,
            "data-source": [
              { "id": "DATA", "title": "Data Bundle" },
              { "id": "AIRTIME", "title": "Airtime Recharge" },
              { "id": "ELECTRICITY", "title": "Electricity Token" },
              { "id": "CABLE", "title": "Cable TV (DStv / GOtv / Startimes)" },
              { "id": "EXAMPIN", "title": "Exam PIN (WAEC / NECO)" },
              { "id": "FUNDING", "title": "Wallet Funding / Deposit" }
            ]
          },
          {
            "type": "TextInput",
            "name": "recipient",
            "label": "Recipient Number",
            "required": true,
            "input-type": "text",
            "helper-text": "Phone, meter or smartcard number"
          },
          {
            "type": "TextInput",
            "name": "reference",
            "label": "Transaction Ref",
            "required": false,
            "input-type": "text",
            "helper-text": "e.g. REF_DATA_..."
          },
          {
            "type": "Dropdown",
            "name": "category",
            "label": "Dispute Issue",
            "required": true,
            "data-source": [
              { "id": "Debited but value not delivered", "title": "Debited but value not delivered" },
              { "id": "Recharge or payment failed", "title": "Recharge or payment failed" },
              { "id": "Token or Exam PIN recovery", "title": "Token or Exam PIN not retrieved" },
              { "id": "Pending bank transfer deposit", "title": "Pending bank transfer deposit" },
              { "id": "General account inquiry", "title": "General inquiry / other issue" }
            ]
          },
          {
            "type": "TextArea",
            "name": "description",
            "label": "Complaint Details",
            "required": true,
            "helper-text": "Describe what occurred so our supervisor can resolve it"
          },
          {
            "type": "TextCaption",
            "text": "100% Encrypted: WAJ VTU staff will NEVER ask for your Transaction PIN or password."
          },
          {
            "type": "Footer",
            "label": "Submit Dispute Ticket",
            "on-click-action": {
              "name": "complete",
              "payload": {
                "service_type": "${form.service_type}",
                "recipient": "${form.recipient}",
                "reference": "${form.reference}",
                "category": "${form.category}",
                "description": "${form.description}"
              }
            }
          }
        ]
      }
    }
  ]
}
