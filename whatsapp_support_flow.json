{
  "version": "3.1",
  "screens": [
    {
      "id": "DISPUTE_FORM",
      "title": "WAJ VTU Support Form",
      "terminal": true,
      "data": {
        "service_type": {
          "type": "string",
          "__example__": "DATA"
        },
        "reference": {
          "type": "string",
          "__example__": "REF_12345"
        }
      },
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "TextHeading",
            "text": "Official Support & Dispute Form"
          },
          {
            "type": "TextSubheading",
            "text": "Submitted details are sent directly to our 24/7 supervisor desk."
          },
          {
            "type": "Dropdown",
            "name": "service_type",
            "label": "Service Category",
            "required": true,
            "data_source": [
              { "id": "DATA", "title": "Data Bundle" },
              { "id": "AIRTIME", "title": "Airtime Recharge" },
              { "id": "ELECTRICITY", "title": "Electricity Token" },
              { "id": "CABLE", "title": "Cable TV (DStv / GOtv / Startimes)" },
              { "id": "EXAMPIN", "title": "Exam PIN (WAEC / NECO)" },
              { "id": "FUNDING", "title": "Wallet Funding / Deposit" }
            ]
          },
          {
            "type": "TextInput",
            "name": "recipient",
            "label": "Recipient Phone / Meter / Smartcard",
            "required": true,
            "input_type": "text",
            "helper_text": "Enter the target phone number, meter number or IUC"
          },
          {
            "type": "TextInput",
            "name": "reference",
            "label": "Transaction Reference (Optional)",
            "required": false,
            "input_type": "text",
            "helper_text": "e.g. REF_DATA_..."
          },
          {
            "type": "Dropdown",
            "name": "category",
            "label": "Dispute Issue",
            "required": true,
            "data_source": [
              { "id": "Debited but value not delivered", "title": "Debited but value not delivered" },
              { "id": "Recharge or payment failed", "title": "Recharge or payment failed" },
              { "id": "Token or Exam PIN recovery", "title": "Token or Exam PIN not retrieved" },
              { "id": "Pending bank transfer deposit", "title": "Pending bank transfer deposit" },
              { "id": "General account inquiry", "title": "General inquiry / other issue" }
            ]
          },
          {
            "type": "TextArea",
            "name": "description",
            "label": "Complaint Details",
            "required": true,
            "helper_text": "Describe what occurred so our supervisor can resolve it"
          },
          {
            "type": "TextCaption",
            "text": "🛡️ 100% Encrypted: WAJ VTU staff will NEVER ask for your Transaction PIN or password."
          },
          {
            "type": "Footer",
            "label": "Submit Dispute Ticket",
            "on_click_action": {
              "name": "complete",
              "payload": {
                "service_type": "${form.service_type}",
                "recipient": "${form.recipient}",
                "reference": "${form.reference}",
                "category": "${form.category}",
                "description": "${form.description}"
              }
            }
          }
        ]
      }
    }
  ]
}
